#!/usr/bin/env raku
use v6.d;

use Test;
use JavaScript::D3;
need JavaScript::D3::Render;

plan 13;

my $line = js-d3-list-line-plot([1, 3, 2]);
like $line, / "require(['d3']" /, 'the default output is a Jupyter wrapper';
like $line, / '}) })(element);' /, 'the Jupyter wrapper closes';

my $html = js-d3-list-line-plot([1, 3, 2], :format<html>, :div-id<line-example>);
like $html, / '<!DOCTYPE html>' /, 'HTML output has a document wrapper';
like $html, / '<div id="line-example"></div>' /, 'HTML output uses the requested target id';
like $html, / '.select("#line-example")' /, 'HTML output scopes D3 to the requested target';

my $fragment = js-d3-list-line-plot([1, 3, 2], :format<html-md>, :div-id<line-fragment>);
unlike $fragment, / '<!DOCTYPE html>' /, 'fragment output omits the document wrapper';
like $fragment, / 'line-fragment' /, 'fragment output retains the requested target id';

my $spec = JavaScript::D3::Render::RenderSpec.new(
        body => 'const moduleBoundary = true;',
        format => 'html',
        div-id => 'render-spec');
my $rendered = JavaScript::D3::Render::render($spec);
like $rendered, / 'const moduleBoundary = true;' /, 'RenderSpec body is preserved';
like $rendered, / '<div id="render-spec"></div>' /, 'Render owns target creation';
is JavaScript::D3::Render::target-expression(:format<jupyter>), 'element.get(0)', 'Jupyter target expression is explicit';
is JavaScript::D3::Render::target-expression(:format<html>, :div-id<custom>), 'document.getElementById("custom")', 'HTML target expression is explicit';

ok js-d3-config.contains('require(["d3", "d3_3d"]'), 'configuration is delegated to the configuration module';
like js-d3-config(:!direct), / '}) })(element);' /, 'embedded configuration has a Jupyter wrapper';
