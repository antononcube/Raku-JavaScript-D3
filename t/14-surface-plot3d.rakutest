#!/usr/bin/env raku
use v6.d;
use Test;
use JavaScript::D3;

plan 22;

my @surface = [[0, 0, 1], [1, 0, 0], [0, 1, 0]];
my $plot = js-list-plot3D(@surface);
like $plot, / 'd3.Delaunay.from' /, 'surface plot triangulates explicit points';
like $plot, / '"surface"' /, 'unlabeled points become the default surface group';
like $plot, / '"z":1' /, 'triplet values become explicit z coordinates';

my $map-plot = js-list-plot3D([
    {x => 0, y => 0, z => 1}, {x => 1, y => 0, z => 0}, {x => 0, y => 1, z => 0}
]);
ok $map-plot.contains('d3.Delaunay.from'), 'x-y-z maps use the same triangulated-surface renderer as coordinate triplets';

my $grouped = js-list-plot3D(%(low => @surface, high => [[0, 0, 2], [1, 0, 1], [0, 1, 1]]));
like $grouped, / '"low"' /, 'map keys become group names';
like $grouped, / '"high"' /, 'each group produces a surface';
like $grouped, / 'surface-legend' /, 'multiple groups show a legend by default';

dies-ok { js-list-plot3D([[0, 0], [1, 0], [0, 1]]) }, 'points without z coordinates are rejected';

my $view-options = js-list-plot3D(
    @surface,
    box-ratios => [2, 3, 0.5],
    view-point => [1, -2, 3],
    view-vertical => [0, 1, 0],
    :zooming-enabled,
    :axes,
    :!boxed,
);
like $view-options, / 'var boxRatios = [2,3,0.5]' /, 'box ratios are emitted for the scene transform';
like $view-options, / 'var viewPoint = [1,-2,3]' /, 'view point is emitted for the camera';
like $view-options, / 'var viewVertical = [0,1,0]' /, 'view vertical is emitted for the camera';
like $view-options, / 'var zoomingEnabled = true' /, 'zooming is enabled in the renderer';
like $view-options, / 'showAxes = true' /, 'axes are enabled in the renderer';
like $view-options, / 'showBoxed = false' /, 'the bounding box can be disabled';
ok $view-options.contains('cameraForward'), 'surface camera is based on the requested view vectors';
like $view-options, / 'selector.split(".")[1]' /, 'frame redraws retain the selected CSS class';
like $plot, / 'surface-tick-label' /, 'ticks are enabled by default';
like $plot, / 'd3.ticks(bounds.x0, bounds.x1, 4)' /, 'ticks are derived from the x data range';
unlike js-list-plot3D(@surface, :!ticks), / 'showTicks = true' /, 'ticks can be disabled';

dies-ok { js-list-plot3D(@surface, box-ratios => [1, 0, 1]) }, 'non-positive box ratios are rejected';
dies-ok { js-list-plot3D(@surface, view-point => [0, 0, 0]) }, 'zero view point is rejected';
dies-ok { js-list-plot3D(@surface, view-vertical => [0, 0, 0]) }, 'zero view vertical is rejected';
